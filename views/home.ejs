<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Student Management System</title>
<link rel="stylesheet" href="/home.css">



</head>

<body>

<header>

<h1>Student Management System</h1>

<nav>

<a href="#">Home</a>

<a href="#">Students</a>

<a href="#">Courses</a>

<a href="#">Teachers</a>

<a href="#">Attendance</a>

<a href="#">Login</a>

</nav>

</header>

<section class="hero">

<h2>Welcome to Student Management System</h2>

<p>Manage Students, Teachers, Courses and Attendance Easily.</p>

<button>Add Student</button>

</section>

<section class="student-form">

<h2>Add Student</h2>

<form id="studentForm">

<label>Student Name</label>

<input type="text" placeholder="Enter Name">

<label>Email</label>

<input type="email" placeholder="Enter Email">

<label>Phone</label>

<input type="text" placeholder="Enter Phone Number">

<label>Course</label>

<select>

<option>BCA</option>

<option>B.Tech</option>

<option>MCA</option>

<option>BBA</option>

</select>

<button type="submit">
Save Student
</button>

</form>

</section>

<section class="student-table">

<h2>Student List</h2>

<table border="1">

<tr>

<th>ID</th>

<th>Name</th>

<th>Email</th>

<th>Phone</th>

<th>Course</th>

<th>Action</th>

</tr>

<tr>

<td>101</td>

<td>Rahul</td>

<td>rahul@gmail.com</td>

<td>9876543210</td>

<td>BCA</td>

<td>

<button>Edit</button>

<button>Delete</button>

</td>

</tr>

</table>

</section>

<footer>

<p>© 2026 Student Management System</p>

</footer>
<script src="/home.js"></script>
</body>

</html>